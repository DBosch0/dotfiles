/**
 * ROFI Color theme
 * User: Qball
 * Copyright: Dave Davenport
 */

@theme '/home/david/.cache/wal/colors-rofi-dark.rasi'

/**
* * {
*    background-color:      Black;
*    border-color:          White;
*    text-color:           White;
*    font:            "Times New Roman 12";
* }
*/

window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    5px 0px 5px 0px;
    children:   [ horibox ];
    y-offset: -40;
}
horibox {
    orientation: horizontal;
    children:   [ entry, listview ];
}
listview {
    layout:     horizontal;
    spacing:    5px;
    lines:      100;
}
entry {
    expand:     false;
    width:      10em;
}
element {
    padding: 1px 2px;
}

element selected {
    background-color: inherit;
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
